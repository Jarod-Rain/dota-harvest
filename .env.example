# Copy to .env and fill in. Never commit .env -- it is gitignored.

# Required. Free token from https://stratz.com/api
STRATZ_TOKEN=

# Optional. Raises the OpenDota rate limit; the free tier works without one.
# https://www.opendota.com/api-keys
OPENDOTA_KEY=

# Optional. Where collected data lives. Relative paths resolve against the
# project root, not the working directory, so a checked-in value means the same
# thing on every machine. Defaults to ./data inside a checkout.
# DOTA_DATA_DIR=../dota-data

# Optional. Manual patch-release overrides; defaults to <data dir>/patches_override.json
# DOTA_PATCHES_OVERRIDE=
